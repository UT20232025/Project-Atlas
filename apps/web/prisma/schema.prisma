// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String
  createdAt                    DateTime  @default(now())
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?
}

model Position {
  id          String   @id @default(cuid())
  userId      String?
  symbol      String
  direction   String
  entryPrice  Float
  quantity    Float
  note        String?
  openedAt    DateTime @default(now())
  // Last follow-up verdict seen by the position watcher (HOLD/CONSIDER/EXIT),
  // so an EXIT alert fires only on the flip, not on every check.
  lastVerdict String?

  @@index([userId])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String?
  symbol     String
  direction  String
  entryPrice Float
  exitPrice  Float
  quantity   Float
  pnl        Float
  pnlPercent Float
  note       String?
  openedAt   DateTime
  closedAt   DateTime @default(now())

  @@index([userId])
}

model SignalSnapshot {
  id           String    @id @default(cuid())
  symbol       String
  interval     String
  signal       String
  confidence   Int
  score        Int
  price        Float?
  outcomePrice Float?
  outcomeAt    DateTime?
  createdAt    DateTime  @default(now())
  // JSON snapshot of the reason/warning codes behind this signal, so we can
  // later correlate which factors actually predict wins and recalibrate the
  // confidence score. { reasons: string[], warnings: string[] }.
  factors      String?

  @@index([symbol, interval, createdAt])
}

// Latest Atlas card for a curated stock, refreshed by the warm-stocks cron.
// One row per ticker (upserted). The /stocks page reads only from here so the
// render path never touches Twelve Data — the free tier is far too rate-limited
// to analyse a dozen stocks on page load. `checklist` is the JSON card payload
// { direction, metCount, total, ready, pending: string[] }.
model StockSnapshot {
  ticker     String   @id
  signal     String
  confidence Int
  price      Float?
  checklist  String
  updatedAt  DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  message   String
  pathname  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  targetPrice Float
  direction   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  @@index([userId])
}

model ExchangeConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  exchange     String
  apiKey       String
  secretCipher String
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// "Notify me when this becomes a trade" — a per-user, per-symbol standing
// request to be pushed the moment an asset (crypto/stock/FX) flips to a
// directional LONG/SHORT setup. lastSignal tracks the last state we notified on
// so a signal that stays directional doesn't re-alert, and a flip back to a new
// direction does. The signal-alerts cron reads current signals from the DB
// (SignalSnapshot / StockSnapshot) so it makes no extra market API calls.
model SignalAlert {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  lastSignal String   @default("WAIT")
  createdAt  DateTime @default(now())

  @@unique([userId, symbol])
  @@index([symbol])
}

model Watchlist {
  id        String            @id @default(cuid())
  userId    String?
  name      String
  createdAt DateTime          @default(now())
  symbols   WatchlistSymbol[]

  @@index([userId])
}

model WatchlistSymbol {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}

// A recorded breakout broadcast, resolved 24h later like the conservative track
// record — so we actually know whether the momentum signals we send are
// profitable. Kept SEPARATE from SignalSnapshot so it never pollutes the
// verified conservative track record.
model BreakoutSignal {
  id           String    @id @default(cuid())
  symbol       String
  direction    String // LONG / SHORT
  strength     Int
  entryPrice   Float
  stopLoss     Float?
  takeProfit   Float?
  createdAt    DateTime  @default(now())
  outcomePrice Float?
  outcomeAt    DateTime?

  @@index([symbol, createdAt])
}
