// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String
  createdAt                    DateTime  @default(now())
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?
}

model Position {
  id          String   @id @default(cuid())
  userId      String?
  symbol      String
  direction   String
  entryPrice  Float
  quantity    Float
  note        String?
  openedAt    DateTime @default(now())
  // Last follow-up verdict seen by the position watcher (HOLD/CONSIDER/EXIT),
  // so an EXIT alert fires only on the flip, not on every check.
  lastVerdict String?

  @@index([userId])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String?
  symbol     String
  direction  String
  entryPrice Float
  exitPrice  Float
  quantity   Float
  pnl        Float
  pnlPercent Float
  note       String?
  openedAt   DateTime
  closedAt   DateTime @default(now())

  @@index([userId])
}

model SignalSnapshot {
  id           String    @id @default(cuid())
  symbol       String
  interval     String
  signal       String
  confidence   Int
  score        Int
  price        Float?
  outcomePrice Float?
  outcomeAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([symbol, interval, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  message   String
  pathname  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  targetPrice Float
  direction   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  @@index([userId])
}

model ExchangeConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  exchange     String
  apiKey       String
  secretCipher String
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Watchlist {
  id        String            @id @default(cuid())
  userId    String?
  name      String
  createdAt DateTime          @default(now())
  symbols   WatchlistSymbol[]

  @@index([userId])
}

model WatchlistSymbol {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}
