// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Position {
  id         String   @id @default(cuid())
  symbol     String
  direction  String
  entryPrice Float
  quantity   Float
  note       String?
  openedAt   DateTime @default(now())
}

model JournalEntry {
  id         String   @id @default(cuid())
  symbol     String
  direction  String
  entryPrice Float
  exitPrice  Float
  quantity   Float
  pnl        Float
  pnlPercent Float
  note       String?
  openedAt   DateTime
  closedAt   DateTime @default(now())
}

model SignalSnapshot {
  id           String    @id @default(cuid())
  symbol       String
  interval     String
  signal       String
  confidence   Int
  score        Int
  price        Float?
  outcomePrice Float?
  outcomeAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([symbol, interval, createdAt])
}

model Watchlist {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  symbols   WatchlistSymbol[]
}

model WatchlistSymbol {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}
